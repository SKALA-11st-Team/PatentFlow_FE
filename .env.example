# PatentFlow FE environment variables
#
# Set VITE_USE_MOCK_API=true in a local .env file to use the frontend mock adapters in src/mocks/.
# Example:
# VITE_USE_MOCK_API=true

# Spring Boot API base URL used by src/api/client.ts.
# Do not include a trailing slash.
VITE_API_BASE_URL=http://localhost:8080/api/v1
